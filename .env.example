# AI Mock Interview Platform - Environment Configuration

# Core Application Settings
PROJECT_NAME="AI Mock Interview Platform"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api"

# Security & Authentication
SECRET_KEY="super-secret-key-change-this-in-production-btech-final-year"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (SQLite default for zero-friction local run; switchable to PostgreSQL)
# Example PostgreSQL: postgresql+psycopg2://postgres:password@localhost:5432/mock_interview_db
DATABASE_URL="sqlite:///./interview_platform.db"

# AI Provider Settings ("mock", "gemini", "openai")
LLM_PROVIDER="mock"
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Storage Configuration
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=15

# CORS Configuration (Comma separated origins)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
